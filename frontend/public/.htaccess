# Hostinger (LiteSpeed/Apache): SPA fallback, same as the rewrite in vercel.json.
# Real files (assets, sw.js, landing pages) are served as-is; every other path
# goes to index.html so React Router can handle /products, /sales, etc. on refresh.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Never cache the service worker or index.html, so updates reach users right away
<FilesMatch "^(sw\.js|index\.html)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Android app download (public_html/download/dukaanai.apk)
AddType application/vnd.android.package-archive .apk
<FilesMatch "\.apk$">
  Header set Content-Disposition "attachment"
  Header set Cache-Control "no-cache"
</FilesMatch>
